{
  "info": {
    "_postman_id": "a1000000-0000-4000-8000-000000000001",
    "name": "AI Ticket It - 01 Categorias",
    "description": "Colección de endpoints REST para el recurso Categorías (/api/categorias)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "categoriaId",
      "value": "11111111-1111-4111-8111-111111111101",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Listar todas las categorías",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/categorias",
          "host": ["{{baseUrl}}"],
          "path": ["categorias"]
        }
      }
    },
    {
      "name": "2. Obtener categoría por ID (Recitales)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/categorias/{{categoriaId}}",
          "host": ["{{baseUrl}}"],
          "path": ["categorias", "{{categoriaId}}"]
        }
      }
    },
    {
      "name": "3. Crear nueva categoría",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Festivales Gastronómicos\",\n  \"descripcion\": \"Ferias de comida, degustaciones y música en vivo\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/categorias",
          "host": ["{{baseUrl}}"],
          "path": ["categorias"]
        }
      }
    },
    {
      "name": "4. [Error 400] Crear categoría sin nombre (Validación temprana)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"descripcion\": \"Categoría inválida sin nombre\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/categorias",
          "host": ["{{baseUrl}}"],
          "path": ["categorias"]
        }
      }
    },
    {
      "name": "5. [Error 409] Crear categoría duplicada (ConflictoEntidadError)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Recitales\",\n  \"descripcion\": \"Intento duplicado\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/categorias",
          "host": ["{{baseUrl}}"],
          "path": ["categorias"]
        }
      }
    }
  ]
}
