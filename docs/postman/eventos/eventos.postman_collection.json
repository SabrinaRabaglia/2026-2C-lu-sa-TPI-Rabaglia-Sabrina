{
  "info": {
    "_postman_id": "a1000000-0000-4000-8000-000000000003",
    "name": "AI Ticket It - 03 Eventos",
    "description": "Colección de endpoints REST para Eventos: catálogo, búsqueda por texto, filtros por categoría y precio, ordenamiento por precio/fecha/puntaje y creación (/api/eventos)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "eventoRockId",
      "value": "44444444-4444-4444-8444-444444444401",
      "type": "string"
    },
    {
      "key": "categoriaRecitalesId",
      "value": "11111111-1111-4111-8111-111111111101",
      "type": "string"
    },
    {
      "key": "organizadorRockId",
      "value": "22222222-2222-4222-8222-222222222201",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Listar todos los eventos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/eventos",
          "host": ["{{baseUrl}}"],
          "path": ["eventos"]
        }
      }
    },
    {
      "name": "2. Buscar eventos por texto y ordenar por precio ascendente",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/eventos?texto=rock&ordenarPor=precio&direccion=asc",
          "host": ["{{baseUrl}}"],
          "path": ["eventos"],
          "query": [
            { "key": "texto", "value": "rock" },
            { "key": "ordenarPor", "value": "precio" },
            { "key": "direccion", "value": "asc" }
          ]
        }
      }
    },
    {
      "name": "3. Filtrar eventos por categoría y rango de precios",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/eventos?categoriaId={{categoriaRecitalesId}}&precioMin=20000&precioMax=50000",
          "host": ["{{baseUrl}}"],
          "path": ["eventos"],
          "query": [
            { "key": "categoriaId", "value": "{{categoriaRecitalesId}}" },
            { "key": "precioMin", "value": "20000" },
            { "key": "precioMax", "value": "50000" }
          ]
        }
      }
    },
    {
      "name": "4. Ordenar eventos por puntaje del organizador (descendente)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/eventos?ordenarPor=puntaje&direccion=desc",
          "host": ["{{baseUrl}}"],
          "path": ["eventos"],
          "query": [
            { "key": "ordenarPor", "value": "puntaje" },
            { "key": "direccion", "value": "desc" }
          ]
        }
      }
    },
    {
      "name": "5. Ordenar eventos por fecha",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/eventos?ordenarPor=fecha&direccion=asc",
          "host": ["{{baseUrl}}"],
          "path": ["eventos"],
          "query": [
            { "key": "ordenarPor", "value": "fecha" },
            { "key": "direccion", "value": "asc" }
          ]
        }
      }
    },
    {
      "name": "6. Obtener detalle de un evento por ID (incluye reseñas y puntaje del organizador)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/eventos/{{eventoRockId}}",
          "host": ["{{baseUrl}}"],
          "path": ["eventos", "{{eventoRockId}}"]
        }
      }
    },
    {
      "name": "7. Crear nuevo evento con múltiples tipos de entrada",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Noche de Jazz & Blues\",\n  \"descripcion\": \"Cuarteto de jazz internacional en vivo\",\n  \"categoriaId\": \"{{categoriaRecitalesId}}\",\n  \"fecha\": \"2027-04-20T21:30:00.000Z\",\n  \"tiposEntrada\": [\n    {\n      \"nombre\": \"General\",\n      \"descripcion\": \"Ubicación por orden de llegada\",\n      \"precio\": 22000,\n      \"cupo\": 120\n    },\n    {\n      \"nombre\": \"Mesa VIP\",\n      \"descripcion\": \"Mesa frente al escenario con consumición\",\n      \"precio\": 48000,\n      \"cupo\": 25\n    }\n  ],\n  \"multimedia\": [\n    \"https://images.unsplash.com/photo-1511192336575-5a79af67a629\"\n  ],\n  \"organizadorId\": \"{{organizadorRockId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/eventos",
          "host": ["{{baseUrl}}"],
          "path": ["eventos"]
        }
      }
    }
  ]
}
