{
  "info": {
    "_postman_id": "a1000000-0000-4000-8000-000000000002",
    "name": "AI Ticket It - 02 Usuarios y Favoritos",
    "description": "Colección de endpoints REST para Usuarios y gestión de Eventos Favoritos (/api/usuarios)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "compradorLuciaId",
      "value": "22222222-2222-4222-8222-222222222203",
      "type": "string"
    },
    {
      "key": "compradorMateoId",
      "value": "22222222-2222-4222-8222-222222222204",
      "type": "string"
    },
    {
      "key": "eventoTeatroId",
      "value": "44444444-4444-4444-8444-444444444402",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Listar todos los usuarios",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/usuarios",
          "host": ["{{baseUrl}}"],
          "path": ["usuarios"]
        }
      }
    },
    {
      "name": "2. Obtener usuario por ID (Lucía Gómez)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/usuarios/{{compradorLuciaId}}",
          "host": ["{{baseUrl}}"],
          "path": ["usuarios", "{{compradorLuciaId}}"]
        }
      }
    },
    {
      "name": "3. Crear nuevo usuario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Valentina\",\n  \"apellido\": \"Sánchez\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/usuarios",
          "host": ["{{baseUrl}}"],
          "path": ["usuarios"]
        }
      }
    },
    {
      "name": "4. Listar eventos favoritos de un usuario (Lucía)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/usuarios/{{compradorLuciaId}}/favoritos",
          "host": ["{{baseUrl}}"],
          "path": ["usuarios", "{{compradorLuciaId}}", "favoritos"]
        }
      }
    },
    {
      "name": "5. Agregar evento a favoritos de Mateo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventoId\": \"{{eventoTeatroId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/usuarios/{{compradorMateoId}}/favoritos",
          "host": ["{{baseUrl}}"],
          "path": ["usuarios", "{{compradorMateoId}}", "favoritos"]
        }
      }
    },
    {
      "name": "6. Quitar evento de favoritos de Mateo",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/usuarios/{{compradorMateoId}}/favoritos/{{eventoTeatroId}}",
          "host": ["{{baseUrl}}"],
          "path": ["usuarios", "{{compradorMateoId}}", "favoritos", "{{eventoTeatroId}}"]
        }
      }
    }
  ]
}
